(* ==================================================================== *)
(* IEC 61131-3 Instruction List (IL) Program                            *)
(* Target Hardware: Raspberry Pi Pico (RP2040)                          *)
(* Generated by uPLC Studio [PksofttecH]                                *)
(* Demo: Electronic Drum Rhythm Generator (เลียนแบบจังหวะกลอง)          *)
(* Compatible with OpenPLC / CODESYS / RP2040 Micro-VM                  *)
(* ==================================================================== *)

PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    X0 AT %IX0.0 : BOOL; (* Pin: GP0 | Symbol: DRUM_ENABLE | Drum Machine Master Run Switch *)
    X1 AT %IX0.1 : BOOL; (* Pin: GP1 | Symbol: FILL_IN_SW  | Drum Roll / Fill-in Turbo Switch *)

    (* --- Digital Outputs (%QX) --- *)
    Y0 AT %QX0.0 : BOOL; (* Pin: GP8 / GP25 | Symbol: BASS_KICK | Kick Drum (1.0s Main Beat via M108) *)
    Y1 AT %QX0.1 : BOOL; (* Pin: GP9 / GP14 | Symbol: SNARE_DRUM| Snare Drum Roll (100ms Pulse on Phase 1) *)
    Y2 AT %QX0.2 : BOOL; (* Pin: GP10/ GP13 | Symbol: HI_HAT    | Hi-Hat Cymbal (100ms Pulse on Phase 2) *)
    Y3 AT %QX0.3 : BOOL; (* Pin: GP11       | Symbol: CRASH_CYM | Crash Accent (10ms High-Speed Pulse) *)

    (* --- Special System Clock Markers --- *)
    (* M106 / %SM10: 10ms Clock Pulse (5ms ON / 5ms OFF, 50Hz) *)
    (* M107 / %SM11: 100ms Clock Pulse (50ms ON / 50ms OFF, 5Hz) *)
    (* M108 / %SM12: 1.0s Clock Pulse (500ms ON / 500ms OFF, 1Hz) *)

END_VAR

(* Network 01: Bass Kick Drum (Y0) - Master Beat 1.0s Pulse (%SM12 / M108) *)
    LD   M108
    AND  X0
    ST   Y0

(* Network 02: Snare Drum (Y1) - High-Speed 100ms Pulse (%SM11 / M107) during Kick ON *)
    LD   M107
    AND  Y0
    ST   Y1

(* Network 03: Hi-Hat Off-Beat (Y2) - High-Speed 100ms Pulse (%SM11 / M107) during Kick OFF *)
    LD   M107
    ANDN Y0
    AND  X0
    ST   Y2

(* Network 04: Crash / Fill-in Turbo Accent (Y3) - 10ms Pulse (%SM10 / M106) when FILL_IN is active *)
    LD   M106
    AND  X1
    ST   Y3

END_PROGRAM
