(* ==================================================================== *)
(* IEC 61131-3 Instruction List (IL) Program                            *)
(* Target Hardware: Raspberry Pi Pico (RP2040)                          *)
(* Generated by LaduinoPLC [PksofttecH]                                *)
(* Example 13: Bitwise word logic, shift registers, ADC and UART0      *)
(* UART0 = GP0 (TX) / GP1 (RX) @ 115200 8N1                            *)
(* Requires firmware feature level 2                                    *)
(* ==================================================================== *)

PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    BTN_SHIFT AT %IX0.0 : BOOL; (* Pin: GP10 | Symbol: BTN_SHIFT | Shift Clock Pushbutton *)
    DATA_BIT AT %IX0.1 : BOOL; (* Pin: GP11 | Symbol: DATA_BIT | Serial Data Input Switch *)
    BTN_RESET AT %IX0.2 : BOOL; (* Pin: GP12 | Symbol: BTN_RESET | Shift Reset Pushbutton *)
    BTN_SEND AT %IX0.3 : BOOL; (* Pin: GP13 | Symbol: BTN_SEND | UART Send Pushbutton *)

    (* --- Digital Outputs (%QX) --- *)
    LAMP_LOGIC AT %QX0.0 : BOOL; (* Pin: GP14 | Symbol: LAMP_LOGIC | Word Logic Active Lamp *)
    LAMP_RX AT %QX0.1 : BOOL; (* Pin: GP15 | Symbol: LAMP_RX | UART Byte Received Pulse *)

    (* --- Function Blocks & Internal Registers --- *)
    U_TX : UART_SEND;
    U_RX : UART_RECV;
END_VAR

(* Network 01: Word logic (OUT A B) every scan *)
    LD   %SM0
    WAND %MW30 %MW31 16#00FF
    WOR  %MW32 %MW30 16#0100
    WXOR %MW33 %MW32 %MW31
    WNOT %MW34 %MW30
    SHL  %MW35 %MW30 2
    SHR  %MW36 %MW31 4
    ST   %QX0.0

(* Network 02: Raw ADC channel %IW1 into %MW50 *)
    LD   %SM0
    ADC  %IW1 %MW50

(* Network 03: On each press of BTN_SHIFT: 8-stage word shift register, shift-in DATA_BIT, rotate pattern *)
    LD   %IX0.0
    SHIFT_REG %MW60 8 %MW50
    SHIFT_BIT %MW70 %IX0.1
    SHIFT_L %MW71 1

(* Network 04: Reset the bit pattern word *)
    LD   %IX0.2
    SHIFT_RST %MW70

(* Network 05: Send %MW60 as ASCII decimal + CRLF on UART0 *)
    LD   %IX0.3
    UART_SEND U_TX(IN := %MW60, MODE := 1)

(* Network 06: Receive bytes from UART0 into %MW81 (LAMP_RX pulses per byte) *)
    LD   %SM0
    UART_RECV U_RX(OUT => %MW81)
    ST   %QX0.1

END_PROGRAM
