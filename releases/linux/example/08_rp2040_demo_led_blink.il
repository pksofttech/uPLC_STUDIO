(* ==================================================================== *)
(* IEC 61131-3 Instruction List (IL) Program                            *)
(* Target Hardware: Raspberry Pi Pico (RP2040)                          *)
(* Generated by uPLC Studio [PksofttecH]                                *)
(* Compatible with OpenPLC / CODESYS / RP2040 Micro-VM                  *)
(* ==================================================================== *)

PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    START_PB AT %IX0.0 : BOOL; (* Pin: GP2 | Symbol: START_PB | Force LED ON Pushbutton (NO) *)
    STOP_PB AT %IX0.1 : BOOL; (* Pin: GP3 | Symbol: STOP_PB | Pause / Stop Blinker Pushbutton (NC) *)

    (* --- Digital Outputs (%QX) --- *)
    LED_PIN AT %QX0.0 : BOOL; (* Pin: GP25 | Symbol: LED_PIN | RP2040 Onboard Demo LED (GP25 / Y0) *)
    LED_ALT AT %QX0.1 : BOOL; (* Pin: GP11 | Symbol: LED_ALT | Alternating Status Output (GP11 / Y1) *)

    (* --- Function Blocks & Internal Variables --- *)
    M_HALF_PERIOD AT %MX0.0 : BOOL; (* Symbol: M_HALF_PERIOD | 500ms Half-Cycle Phase Flag *)
    M_CYCLE_RST AT %MX0.1 : BOOL; (* Symbol: M_CYCLE_RST | 1000ms Full-Cycle Reset Pulse *)
    T0 : TON; (* Preset: 500ms | Symbol: TON_ON_PHASE | LED ON Phase Timer (500ms) *)
    T1 : TON; (* Preset: 500ms | Symbol: TON_OFF_PHASE | LED OFF Phase Timer (500ms) *)
END_VAR

(* Network 01: Oscillator Phase 1 Timer (T0 = 500ms ON Phase, auto-runs when STOP_PB %IX0.1 is OFF) *)
    LDN  %IX0.1
    ANDN %MX0.1
    CAL  T0(IN := TRUE, PT := T#500ms)
    ST   %MX0.0

(* Network 02: Oscillator Phase 2 Timer (T1 = 500ms OFF Phase -> Resets T0 at 1000ms) *)
    LD   %MX0.0
    CAL  T1(IN := TRUE, PT := T#500ms)
    ST   %MX0.1

(* Network 03: RP2040 Onboard Demo LED Output (%QX0.0 / GP25) - Blinks 1Hz (500ms ON / 500ms OFF) *)
    LDN  %IX0.1
    ANDN %MX0.0
    OR   %IX0.0
    ST   %QX0.0

(* Network 04: Alternating Secondary Output (%QX0.1 / GP11) - Opposite Phase to Demo LED *)
    LD   %MX0.0
    ST   %QX0.1

END_PROGRAM
