PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    X0 AT %IX0.0 : BOOL; (* Pin: GP10 | Symbol: IN_0 | RP2040 Digital Input *)
    X1 AT %IX0.1 : BOOL; (* Pin: GP11 | Symbol: IN_1 | RP2040 Digital Input *)
    X2 AT %IX0.2 : BOOL; (* Pin: GP12 | Symbol: IN_2 | RP2040 Digital Input *)
    X3 AT %IX0.3 : BOOL; (* Pin: GP13 | Symbol: IN_3 | RP2040 Digital Input *)

    (* --- Digital Outputs (%QX) --- *)
    Y0 AT %QX0.0 : BOOL; (* Pin: GP15 | Symbol: OUT_0 | RP2040 Digital Output *)
    Y1 AT %QX0.1 : BOOL; (* Pin: GP14 | Symbol: OUT_1 | RP2040 Digital Output *)
    Y2 AT %QX0.2 : BOOL; (* Pin: GP7 | Symbol: OUT_2 | RP2040 Digital Output *)
    Y3 AT %QX0.3 : BOOL; (* Pin: GP6 | Symbol: OUT_3 | RP2040 Digital Output *)
    Y4 AT %QX0.4 : BOOL; (* Pin: GP2 | Symbol: OUT_4 | RP2040 Digital Output *)
    Y5 AT %QX0.5 : BOOL; (* Pin: GP3 | Symbol: OUT_5 | RP2040 Digital Output *)

    (* --- Function Blocks & Internal Registers --- *)
    T0 : TON; (* Preset: 1000ms *)
    T1 : TOF; (* Preset: 1000ms *)
END_VAR

(* Network 01 *)
    LD   %IX0.0
    ST   T0.IN
    LD   T#1000ms
    ST   T0.PT
    CAL  T0

    LD   T0.Q
    ST   T1.IN
    LD   T#1000ms
    ST   T1.PT
    CAL  T1

    LD   T1.Q
    ST   %QX0.0

END_PROGRAM
