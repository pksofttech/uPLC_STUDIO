PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    X0 AT %IX0.0 : BOOL; (* Pin: GP10 | Symbol: START | RP2040 Digital Input *)
    X1 AT %IX0.1 : BOOL; (* Pin: GP11 | Symbol: STOP | RP2040 Digital Input *)
    X2 AT %IX0.2 : BOOL; (* Pin: GP12 | Symbol: IN_2 | RP2040 Digital Input *)
    X3 AT %IX0.3 : BOOL; (* Pin: GP13 | Symbol: IN_3 | RP2040 Digital Input *)

    (* --- Digital Outputs (%QX) --- *)
    Y0 AT %QX0.0 : BOOL; (* Pin: GP15 | Symbol: C_IN | RP2040 Digital Output *)
    Y1 AT %QX0.1 : BOOL; (* Pin: GP14 | Symbol: STOP_B | RP2040 Digital Output *)
    Y2 AT %QX0.2 : BOOL; (* Pin: GP7 | Symbol: C_OUT | RP2040 Digital Output *)
    Y3 AT %QX0.3 : BOOL; (* Pin: GP6 | Symbol: TR-01 | RP2040 Digital Output *)
    Y4 AT %QX0.4 : BOOL; (* Pin: GP2 | Symbol: OUT_4 | RP2040 Digital Output *)
    Y5 AT %QX0.5 : BOOL; (* Pin: GP3 | Symbol: TR-02 | RP2040 Digital Output *)

    (* --- Function Blocks & Internal Registers --- *)
    %IW0 : INT := 0; (* Internal Register *)
    T0 : TOF; (* Preset: 500ms *)
END_VAR

(* Network 01:  *)
    LD   %IX0.0
    OR   %MX0.0
    AND  %IX0.1
    ST   %MX0.0

(* Network 02:  *)
    LD   %MX0.0
    ST   %QX0.0

(* Network 03:  *)
    LD   %MX0.0
    ST   %QX0.2

(* Network 04:  *)
    LD   %MX0.0
    NE   %IW0 1
    NE   %IW0 2
    ST   %QX0.3

(* Network 05:  *)
    LD   %MX0.0
    NE   %IW0 3
    NE   %IW0 4
    ST   %QX0.5

(* Network 06:  *)
    LD   %MX0.0
    NE   %IW0 5
    NE   %IW0 6
    ST   %QX0.7

(* Network 07:  *)
    NE   %IW0 0
    CAL  T0(IN := TRUE, PT := T#500ms)
    STN  %QX0.1

(* Network 08:  *)

END_PROGRAM
