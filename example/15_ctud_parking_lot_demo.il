(* ==================================================================== *)
(* IEC 61131-3 Instruction List (IL) Program                            *)
(* Target Hardware: Raspberry Pi Pico (RP2040)                          *)
(* Program: 15_ctud_parking_lot_demo.il                                 *)
(* Description: CTUD Up/Down Counter - Smart Parking Lot Control Demo   *)
(* Generated by uPLC Studio [PksofttecH]                                *)
(* Compatible with OpenPLC / CODESYS                                    *)
(* ==================================================================== *)

PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    CAR_IN AT %IX0.0 : BOOL; (* Pin: GP2 | Symbol: CAR_IN | Entry Gate Photo Sensor (Count Up +1) *)
    CAR_OUT AT %IX0.1 : BOOL; (* Pin: GP3 | Symbol: CAR_OUT | Exit Gate Photo Sensor (Count Down -1) *)
    RESET_PB AT %IX0.2 : BOOL; (* Pin: GP4 | Symbol: RESET_PB | Master Reset Pushbutton (Clear C0=0) *)

    (* --- Digital Outputs (%QX) --- *)
    GREEN_OPEN AT %QX0.0 : BOOL; (* Pin: GP10 | Symbol: GREEN_OPEN | Green Lamp - Space Available (C0 < 5) *)
    YELLOW_WARN AT %QX0.1 : BOOL; (* Pin: GP11 | Symbol: YELLOW_WARN | Yellow Lamp - Almost Full (C0 = 4) *)
    RED_FULL AT %QX0.2 : BOOL; (* Pin: GP12 | Symbol: RED_FULL | Red Lamp - Parking Full (C0 >= 5) *)
    LOT_EMPTY AT %QX0.3 : BOOL; (* Pin: GP13 | Symbol: LOT_EMPTY | Indicator - Parking Lot Empty (C0 = 0) *)
    GATE_OPEN AT %QX0.4 : BOOL; (* Pin: GP14 | Symbol: GATE_OPEN | Entry Barrier Gate Actuator (1s Pulse) *)

    (* --- Function Blocks & Internal Variables --- *)
    C0 : CTUD; (* Preset: 5 | Symbol: CTUD_PARK | Up/Down Parking Occupancy Counter (Max 5 Cars) *)
    T0 : TP; (* Preset: 1000ms | Symbol: TP_GATE | Entry Barrier Gate Pulse Timer (1000ms) *)
END_VAR

(* Network 01: Car Enters (%IX0.0) when Lot is NOT Full (%QX0.2) -> Count UP on CTUD C0 (PV=5) *)
    LD   %IX0.0
    ANDN %QX0.2
    CAL  C0(CU := TRUE, PV := 5)
    ST   %QX0.2

(* Network 02: Car Exits (%IX0.1) -> Count DOWN on the same Counter C0 (PV=5) *)
    LD   %IX0.1
    CAL  C0(CD := TRUE, PV := 5)

(* Network 03: Green Available Lamp (%QX0.0) is ON whenever Lot is NOT Full (%QX0.2) *)
    LDN  %QX0.2
    ST   %QX0.0

(* Network 04: Yellow Warning Lamp (%QX0.1) turns ON when 4 Cars are parked (1 Spot Left) *)
    LD   %QX0.0
    EQ   C0 4
    ST   %QX0.1

(* Network 05: Lot Empty Indicator (%QX0.3) turns ON when C0 == 0 *)
    LDN  %QX0.2
    EQ   C0 0
    ST   %QX0.3

(* Network 06: Open Entry Barrier Gate (%QX0.4) for 1000ms when Car Enters and Space is Available *)
    LD   %IX0.0
    ANDN %QX0.2
    CAL  T0(IN := TRUE, PT := T#1000ms)
    ST   %QX0.4

(* Network 07: Master Reset Button (%IX0.2) resets CTUD Counter C0 back to 0 *)
    LD   %IX0.2
    R    C0

END_PROGRAM
