(* ==================================================================== *)
(* IEC 61131-3 Instruction List (IL) Program                            *)
(* Target Hardware: Arduino UNO R3                                      *)
(* Generated by uPLC Studio [PksofttecH]                                *)
(* Compatible with OpenPLC / CODESYS                                    *)
(* ==================================================================== *)

PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    START_PB AT %IX0.0 : BOOL; (* Pin: D2 | Symbol: START_PB | Start Pushbutton (NO) *)
    STOP_PB AT %IX0.1 : BOOL; (* Pin: D3 | Symbol: STOP_PB | Stop Pushbutton (NC) *)
    SENS_LIMIT AT %IX0.2 : BOOL; (* Pin: D4 | Symbol: SENS_LIMIT | Proximity Limit Switch *)
    EMERGENCY AT %IX0.3 : BOOL; (* Pin: D5 | Symbol: EMERGENCY | Emergency Stop *)

    (* --- Digital Outputs (%QX) --- *)
    MOTOR_RUN AT %QX0.0 : BOOL; (* Pin: D8 | Symbol: MOTOR_RUN | Main Motor Contactor *)
    LAMP_RUN AT %QX0.1 : BOOL; (* Pin: D9 | Symbol: LAMP_RUN | Running Indicator Lamp (Green) *)
    ALARM_BUZZER AT %QX0.2 : BOOL; (* Pin: D10 | Symbol: ALARM_BUZZER | Warning Alarm Buzzer *)
    LAMP_FAULT AT %QX0.3 : BOOL; (* Pin: D13 | Symbol: LAMP_FAULT | Fault Indicator Lamp (Red) *)

    (* --- Function Blocks & Internal Registers --- *)
    T0 : TON; (* Preset: 3000ms | Symbol: DELAY_ALARM | Alarm On-Delay Timer *)
END_VAR

(* Network 01: Main Motor Start/Stop with Self-Holding Latch *)
    LD   %IX0.0
    OR   %QX0.0
    ANDN %IX0.1
    ST   %QX0.0

(* Network 02: Running Indicator Lamp follows Motor Status *)
    LD   %QX0.0
    ST   %QX0.1

(* Network 03: Timer On Delay (3s) activates Warning Alarm *)
    LD   %QX0.0
    CAL  T0(IN := TRUE, PT := T#3000ms)
    AND  T0
    ST   %QX0.2

END_PROGRAM
