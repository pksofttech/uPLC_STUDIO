PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    X0 AT %IX0.0 : BOOL; (* Pin: D2 | Symbol: START_PB | Start Pushbutton (NO) *)
    X1 AT %IX0.1 : BOOL; (* Pin: D3 | Symbol: STOP_PB | Stop Pushbutton (NC) *)
    X2 AT %IX0.2 : BOOL; (* Pin: D4 | Symbol: SENS_LIMIT | Proximity Limit Switch *)
    X3 AT %IX0.3 : BOOL; (* Pin: D5 | Symbol: EMERGENCY | Emergency Stop *)

    (* --- Digital Outputs (%QX) --- *)
    Y0 AT %QX0.0 : BOOL; (* Pin: D8 | Symbol: MOTOR_RUN | Main Motor Contactor *)
    Y1 AT %QX0.1 : BOOL; (* Pin: D9 | Symbol: LAMP_RUN | Running Indicator Lamp (Green) *)
    Y2 AT %QX0.2 : BOOL; (* Pin: D10 | Symbol: ALARM_BUZZER | Warning Alarm Buzzer *)
    Y3 AT %QX0.3 : BOOL; (* Pin: D13 | Symbol: LAMP_FAULT | Fault Indicator Lamp (Red) *)

END_VAR

(* Network 01:  *)
    LD   %IX0.0
    ST   %QX0.0

END_PROGRAM
