(* ==================================================================== *)
(* IEC 61131-3 Instruction List (IL) Program                            *)
(* Target Hardware: Arduino UNO R3                                      *)
(* Program: 04_counter_batch_pack.il                                    *)
(* Description: Conveyor Batch Counter, Box Sealer & Batch Reset Demo   *)
(* Generated by uPLC Studio [PksofttecH]                                *)
(* Compatible with OpenPLC / CODESYS                                    *)
(* ==================================================================== *)

PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    START_PB AT %IX0.0 : BOOL; (* Pin: D2 | Symbol: START_PB | Conveyor Start Pushbutton *)
    STOP_PB AT %IX0.1 : BOOL; (* Pin: D3 | Symbol: STOP_PB | Conveyor Stop Pushbutton *)
    PHOTO_SENS AT %IX0.2 : BOOL; (* Pin: D4 | Symbol: PHOTO_SENS | Item Detection Photo Sensor *)
    RESET_PB AT %IX0.3 : BOOL; (* Pin: D5 | Symbol: RESET_PB | Batch Counter Reset Pushbutton *)

    (* --- Digital Outputs (%QX) --- *)
    CONV_MOTOR AT %QX0.0 : BOOL; (* Pin: D8 | Symbol: CONV_MOTOR | Conveyor Belt Motor *)
    BATCH_FULL AT %QX0.1 : BOOL; (* Pin: D9 | Symbol: BATCH_FULL | Batch Full Indicator Lamp *)
    BOX_SEALER AT %QX0.2 : BOOL; (* Pin: D10 | Symbol: BOX_SEALER | Box Sealer Actuator *)
    PALLET_DONE AT %QX0.3 : BOOL; (* Pin: D11 | Symbol: PALLET_DONE | Pallet Complete Lamp (3 Boxes) *)

    (* --- Function Blocks & Internal Variables --- *)
    C0 : CTU; (* Preset: 5 | Symbol: CTU_BATCH | Batch Item Counter (PV=5) *)
    C1 : CTU; (* Preset: 3 | Symbol: CTU_BOXES | Total Packed Boxes Counter (PV=3) *)
    T0 : TON; (* Preset: 1500ms | Symbol: TON_SEALER | Box Sealer Hold Timer *)
END_VAR

(* Network 01: Conveyor Belt Motor (%QX0.0) - Stops automatically when Batch Counter C0 reaches 5 *)
    LD   %IX0.0
    OR   %QX0.0
    ANDN %IX0.1
    ANDN %QX0.1
    ST   %QX0.0

(* Network 02: Photo Sensor (%IX0.2) counts items up to 5 (CTU C0) -> Batch Full (%QX0.1) *)
    LD   %IX0.2
    CAL  C0(CU := TRUE, PV := 5)
    ST   %QX0.1

(* Network 03: Box Sealer Actuator (%QX0.2) runs after 1500ms when Batch is Full (%QX0.1) *)
    LD   %QX0.1
    CAL  T0(IN := TRUE, PT := T#1500ms)
    ST   %QX0.2

(* Network 04: Count completed boxes (CTU C1, PV=3) when Box Sealer (%QX0.2) finishes *)
    LD   %QX0.2
    CAL  C1(CU := TRUE, PV := 3)
    ST   %QX0.3

(* Network 05: Reset Pushbutton (%IX0.3) clears Batch Item Counter C0 for the next box *)
    LD   %IX0.3
    R    C0

END_PROGRAM
