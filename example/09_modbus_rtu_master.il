(* ==================================================================== *)
(* IEC 61131-3 Instruction List (IL) Program                            *)
(* Target Hardware: Raspberry Pi Pico (RP2040)                          *)
(* Transceiver: MAX485 / SP3485 (RS-485 Half-Duplex)                   *)
(* RS-485 Pins: GP20 (TX), GP21 (RX), GP22 (Direction DE/RE)            *)
(* Generated by uPLC Studio [PksofttecH]                                *)
(* ==================================================================== *)

PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    AUTO_POLL_SW AT %IX0.0 : BOOL; (* Pin: GP2 | Symbol: AUTO_POLL_SW | Enable Cyclic Modbus Polling (NO) *)
    MANUAL_TRIG AT %IX0.1 : BOOL;  (* Pin: GP3 | Symbol: MANUAL_TRIG  | Single-Shot Trigger Button (NO) *)

    (* --- Digital Outputs (%QX) --- *)
    COMM_ACTIVE_LED AT %QX0.0 : BOOL; (* Pin: GP25 | Symbol: COMM_ACTIVE_LED | RP2040 Onboard LED - High while polling *)
    COMM_ERROR_ALM  AT %QX0.1 : BOOL; (* Pin: GP11 | Symbol: COMM_ERROR_ALM  | Alarm Output on Comm Timeout *)

    (* --- Internal Sequencer Relays (%MX) --- *)
    M_STEP1_TEMP  AT %MX0.0 : BOOL; (* Step 1 Active: Read Temperature Sensor (Slave 1) *)
    M_STEP2_METER AT %MX0.1 : BOOL; (* Step 2 Active: Read Power Meter (Slave 2) *)
    M_STEP3_VFD   AT %MX0.2 : BOOL; (* Step 3 Active: Write Frequency to Inverter (Slave 3) *)
    M_COMM_CYCLE  AT %MX0.3 : BOOL; (* Cyclic Poll Interval Trigger Flag *)

    (* --- Communication Function Blocks --- *)
    T_CYCLE : TON; (* Preset: 500ms | 500ms Heartbeat Poll Timer *)
    MB0 : MB_MASTER; (* Slave: 1, Func: 3, Addr: 1, Count: 1, Buffer: D10 | Read Temperature Sensor *)
    MB1 : MB_MASTER; (* Slave: 2, Func: 3, Addr: 16, Count: 2, Buffer: D20 | Read Power Meter *)
    MB2 : MB_MASTER; (* Slave: 3, Func: 6, Addr: 8193, Count: 1, Buffer: D30 | Write VFD Speed Setpoint *)
END_VAR

(* Network 01: 500ms Cyclic Heartbeat Timer to start next Modbus Poll Cycle *)
    LD   %IX0.0
    ANDN %MX0.0
    ANDN %MX0.1
    ANDN %MX0.2
    CAL  T_CYCLE(IN := TRUE, PT := T#500ms)
    ST   %MX0.3

(* Network 02: Start Sequence - Enter Step 1 on Poll Timer Pulse or Manual Button *)
    LD   %MX0.3
    OR   %IX0.1
    S    %MX0.0

(* Network 03: Step 1 - Poll Temperature Sensor via Modbus RTU (Slave ID 1, FC 03 -> D10) *)
    LD   %MX0.0
    CAL  MB0(SLAVE := 1, FUNC := 3, ADDR := 1, COUNT := 1, BUFFER := D10)
    S    %MX0.1
    R    %MX0.0

(* Network 04: Step 2 - Poll Power Meter via Modbus RTU (Slave ID 2, FC 03 -> D20, D21) *)
    LD   %MX0.1
    CAL  MB1(SLAVE := 2, FUNC := 3, ADDR := 16, COUNT := 2, BUFFER := D20)
    S    %MX0.2
    R    %MX0.1

(* Network 05: Step 3 - Send Target Speed to VFD Inverter via Modbus RTU (Slave ID 3, FC 06 <- D30) *)
    LD   %MX0.2
    CAL  MB2(SLAVE := 3, FUNC := 6, ADDR := 8193, COUNT := 1, BUFFER := D30)
    R    %MX0.2

(* Network 06: Status Indication - Turn Onboard Demo LED (GP25 / Y0) while any communication step is active *)
    LD   %MX0.0
    OR   %MX0.1
    OR   %MX0.2
    ST   %QX0.0

END_PROGRAM
