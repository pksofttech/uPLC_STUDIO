(* ==================================================================== *)
(* IEC 61131-3 Instruction List (IL) Program                            *)
(* Target Hardware: Raspberry Pi Pico (RP2040)                          *)
(* Program: 16_toggle_relay_demo.il                                     *)
(* Description: Single-Button Push-On/Push-Off Toggle Relay Demo        *)
(* Generated by uPLC Studio [PksofttecH]                                *)
(* Compatible with OpenPLC / CODESYS                                    *)
(* ==================================================================== *)

PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    PB_TOGGLE_A AT %IX0.0 : BOOL; (* Pin: GP2 | Symbol: PB_TOGGLE_A | Pushbutton A (XOR Toggle Relay Ch1) *)
    PB_TOGGLE_B AT %IX0.1 : BOOL; (* Pin: GP3 | Symbol: PB_TOGGLE_B | Pushbutton B (Counter Toggle Relay Ch2) *)
    MASTER_OFF AT %IX0.2 : BOOL; (* Pin: GP4 | Symbol: MASTER_OFF | Master Off / Reset All Pushbutton *)

    (* --- Digital Outputs (%QX) --- *)
    RELAY_CH1 AT %QX0.0 : BOOL; (* Pin: GP10 | Symbol: RELAY_CH1 | Toggle Output Ch1 (XOR Flip-Flop) *)
    RELAY_CH2 AT %QX0.1 : BOOL; (* Pin: GP11 | Symbol: RELAY_CH2 | Toggle Output Ch2 (Counter C0 Flip-Flop) *)
    BOTH_ON_LAMP AT %QX0.2 : BOOL; (* Pin: GP12 | Symbol: BOTH_ON_LAMP | Indicator - Both Ch1 & Ch2 are ON *)

    (* --- Function Blocks & Internal Variables --- *)
    TRIG_1SCAN AT %MX0.0 : BOOL; (* Symbol: TRIG_1SCAN | 1-Scan Rising Edge Pulse for PB_TOGGLE_A *)
    C0 : CTU; (* Preset: 2 | Symbol: CTU_TOGGLE | Modulo-2 Toggle Counter (0=OFF, 1=ON, 2=Reset) *)
END_VAR

(* Network 01: Generate 1-Scan Rising Pulse (%MX0.0) when PB_TOGGLE_A (%IX0.0) is pressed *)
    LD   %IX0.0
    STP  %MX0.0

(* Network 02: Method 1 - Standard XOR Flip-Flop Toggle Relay (%QX0.0) with Master Off (%IX0.2) *)
    LD   %MX0.0
    ANDN %QX0.0
    ORN( %MX0.0
    AND  %QX0.0
    )
    ANDN %IX0.2
    ST   %QX0.0

(* Network 03: Method 2 - Counter Toggle (%IX0.1): C0 counts 0 -> 1 -> 2, auto-resets to 0 at 2 *)
    LD   %IX0.1
    CAL  C0(CU := TRUE, PV := 2)
    R    C0

(* Network 04: Master Off (%IX0.2) also resets Counter C0 to 0 *)
    LD   %IX0.2
    R    C0

(* Network 05: Relay Ch2 (%QX0.1) is ON whenever Counter C0 == 1 *)
    LDN  %IX0.2
    EQ   C0 1
    ST   %QX0.1

(* Network 06: Both Channels Active Indicator (%QX0.2) turns ON when Ch1 AND Ch2 are both ON *)
    LD   %QX0.0
    AND  %QX0.1
    ST   %QX0.2

END_PROGRAM
