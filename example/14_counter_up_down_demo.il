(* ==================================================================== *)
(* IEC 61131-3 Instruction List (IL) Program                            *)
(* Target Hardware: Raspberry Pi Pico (RP2040)                          *)
(* Program: 14_counter_up_down_demo.il                                  *)
(* Description: Counter CTU (Up), CTD (Down), Compare & Reset Demo      *)
(* Generated by uPLC Studio [PksofttecH]                                *)
(* Compatible with OpenPLC / CODESYS                                    *)
(* ==================================================================== *)

PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    PULSE_UP AT %IX0.0 : BOOL; (* Pin: GP2 | Symbol: PULSE_UP | Count Up Sensor Pulse (CTU C0) *)
    PULSE_DN AT %IX0.1 : BOOL; (* Pin: GP3 | Symbol: PULSE_DN | Count Down Sensor Pulse (CTD C1) *)
    RESET_PB AT %IX0.2 : BOOL; (* Pin: GP4 | Symbol: RESET_PB | Reset C0=0 & Reload C1=5 Pushbutton *)

    (* --- Digital Outputs (%QX) --- *)
    UP_DONE_LAMP AT %QX0.0 : BOOL; (* Pin: GP10 | Symbol: UP_DONE_LAMP | CTU C0 Reached Target (5 Items) *)
    WARN_80_LAMP AT %QX0.1 : BOOL; (* Pin: GP11 | Symbol: WARN_80_LAMP | CTU C0 Warning Threshold (C0 >= 4) *)
    DN_ZERO_LAMP AT %QX0.2 : BOOL; (* Pin: GP12 | Symbol: DN_ZERO_LAMP | CTD C1 Countdown Reached Zero (0) *)
    ACTIVE_LAMP AT %QX0.3 : BOOL; (* Pin: GP13 | Symbol: ACTIVE_LAMP | Counter C0 Has Items (C0 > 0) *)

    (* --- Function Blocks & Internal Variables --- *)
    C0 : CTU; (* Preset: 5 | Symbol: CTU_UP_DEMO | Up Counter (0 -> 5) *)
    C1 : CTD; (* Preset: 5 | Symbol: CTD_DN_DEMO | Down Counter (5 -> 0) *)
END_VAR

(* Network 01: Count Up (CTU C0, PV=5) on %IX0.0 rising edge -> Turns ON %QX0.0 at 5 *)
    LD   %IX0.0
    CAL  C0(CU := TRUE, PV := 5)
    ST   %QX0.0

(* Network 02: Warning Lamp (%QX0.1) turns ON when Up Counter C0 >= 4 *)
    LDN  %QX0.0
    GE   C0 4
    ST   %QX0.1

(* Network 03: Active Indicator (%QX0.3) turns ON whenever C0 > 0 *)
    LDN  %IX0.2
    GT   C0 0
    ST   %QX0.3

(* Network 04: Count Down (CTD C1, PV=5) on %IX0.1 rising edge -> Turns ON %QX0.2 at 0 *)
    LD   %IX0.1
    CAL  C1(CD := TRUE, PV := 5)
    ST   %QX0.2

(* Network 05: Reset Pushbutton (%IX0.2) clears C0 to 0 and reloads C1 preset to 5 *)
    LD   %IX0.2
    R    C0
    R    C1
    MOVE C1 5

END_PROGRAM
