(* ==================================================================== *)
(* IEC 61131-3 Instruction List (IL) Program                            *)
(* Target Hardware: Raspberry Pi Pico (RP2040)                          *)
(* Generated by LaduinoPLC [PksofttecH]                                *)
(* Example 12: SCALE + LIMIT + PID temperature control loop            *)
(* Requires firmware feature level 2 (OPND / PID / SCALE / LIMIT)      *)
(* ==================================================================== *)

PROGRAM MainProgram
VAR
    (* --- Digital Inputs (%IX) --- *)
    PID_ENABLE AT %IX0.0 : BOOL; (* Pin: GP10 | Symbol: PID_ENABLE | PID Loop Enable Switch *)
    SP_HIGH AT %IX0.1 : BOOL; (* Pin: GP11 | Symbol: SP_HIGH | Select High Setpoint (75.0 C) *)

    (* --- Digital Outputs (%QX) --- *)
    HEATER_ON AT %QX0.0 : BOOL; (* Pin: GP14 | Symbol: HEATER_ON | Heater Output Active Lamp *)
    OVER_TEMP AT %QX0.1 : BOOL; (* Pin: GP15 | Symbol: OVER_TEMP | Over-Temperature Alarm *)

    (* --- Function Blocks & Internal Registers --- *)
    SC_TEMP : SCALE;
    LIM_PV : LIMIT;
    TEMP_PID : PID; (* Kp=1.25 Ki=0.10 Kd=0.00 OutMax=1000 *)
END_VAR

(* Network 01: Scale ADC %IW0 (0..4095) to process value %MW10 (0..1000 = 0.0..100.0 C) and clamp into %MW13 *)
    LD   %SM0
    CAL  SC_TEMP(IN := %IW0, OUT => %MW10, IN_MIN := 0, IN_MAX := 4095, OUT_MIN := 0, OUT_MAX := 1000)
    CAL  LIM_PV(IN := %MW10, OUT => %MW13, MN := 0, MX := 950)

(* Network 02: Default setpoint %MW11 = 50.0 C *)
    LDN  %IX0.1
    MOVE %MW11 500

(* Network 03: High setpoint %MW11 = 75.0 C *)
    LD   %IX0.1
    MOVE %MW11 750

(* Network 04: PID loop (PV %MW13, SP %MW11, CV %MW12 = heater power 0..1000) *)
    LD   %IX0.0
    CAL  TEMP_PID(PV := %MW13, SP := %MW11, CV => %MW12, KP := 125, KI := 10, KD := 0, OUTMAX := 1000)

(* Network 05: Heater lamp while CV > 0 *)
    LD   %IX0.0
    GT   %MW12 0
    ST   %QX0.0

(* Network 06: Over-temperature alarm at 90.0 C *)
    LD   %SM0
    GE   %MW10 900
    ST   %QX0.1

END_PROGRAM
